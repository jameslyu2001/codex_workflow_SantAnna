# Global safety policy adapted from the upstream git guardrails.

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Use a recoverable Git operation or obtain explicit user authorization for history/data destruction.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean", "-f"],
    decision = "forbidden",
    justification = "Inspect untracked files first and use a recoverable cleanup method.",
    match = ["git clean -f", "git clean -f -d"],
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Inspect untracked files first and use a recoverable cleanup method.",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "clean", ["-fdx", "-fx", "--force"]],
    decision = "forbidden",
    justification = "Inspect untracked and ignored files with git clean -n; delete only explicit targets.",
    match = ["git clean -fdx", "git clean -fx", "git clean --force"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "prompt",
    justification = "Force-pushing rewrites remote history and requires explicit confirmation.",
    match = ["git push --force", "git push --force origin main"],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "prompt",
    justification = "Force-pushing rewrites remote history and requires explicit confirmation.",
    match = ["git push -f", "git push -f origin main"],
)

prefix_rule(
    pattern = ["git", "add", "-A"],
    decision = "prompt",
    justification = "Review and stage an explicit file set so unrelated user changes are not included accidentally.",
    match = ["git add -A"],
)

prefix_rule(
    pattern = ["git", "add", ["--all", ".", ":/"]],
    decision = "prompt",
    justification = "Review and stage explicit paths so secrets, data, and unrelated work are not included accidentally.",
    match = ["git add --all", "git add .", "git add :/"],
)

prefix_rule(
    pattern = ["git", "checkout", "--", "."],
    decision = "forbidden",
    justification = "Mass discard is irreversible. Restore specific files or use git stash to preserve work.",
    match = ["git checkout -- ."],
)

prefix_rule(
    pattern = ["git", "restore", "."],
    decision = "forbidden",
    justification = "Mass discard is irreversible. Restore specific files or use git stash to preserve work.",
    match = ["git restore ."],
)
